---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ShareButton from "@/components/ShareButton.astro";
import { toUrlSlug } from "@/utils/slug";

type Props = { article: CollectionEntry<"articles"> };

export const getStaticPaths: GetStaticPaths = async () => {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map(article => ({
    params: { slug: toUrlSlug(article.id) },
    props: { article },
  }));
};

const { article } = Astro.props as Props;
const { Content, headings } = await render(article);

// Long pieces get a contents list. Sections only (h2); anything shorter
// than five sections navigates fine by scrolling.
const sections = headings.filter(h => h.depth === 2);
const showToc = sections.length >= 5;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const isoDate = article.data.pubDate.toISOString().slice(0, 10);

// Canonical public URL. Built from `site` rather than read from the browser
// so a link copied during a local preview still points at articles.kwon.ai.
const shareUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<Layout title={article.data.title} description={article.data.description}>
  <main class="mx-auto w-full max-w-2xl flex-1 px-6 py-12" data-pagefind-body>
    <header class="mb-10">
      <div class="flex items-center justify-between gap-3">
        <time
          datetime={isoDate}
          class="font-mono text-sm text-muted-foreground"
        >
          {dateFormatter.format(article.data.pubDate)}
        </time>
        <ShareButton url={shareUrl} />
      </div>
      <h1
        class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl"
      >
        {article.data.title}
      </h1>
      <p class="mt-3 text-lg text-muted-foreground">
        {article.data.description}
      </p>
      {
        article.data.tags.length > 0 && (
          <div
            class="mt-4 flex flex-wrap gap-2"
            data-pagefind-meta={`tags:${article.data.tags.join(",")}`}
          >
            {article.data.tags.map(tag => (
              <a
                href={`/?tag=${tag}`}
                class="rounded-md border border-border bg-secondary px-2 py-0.5 font-mono text-xs text-muted-foreground hover:text-foreground"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </header>

    {
      showToc && (
        <nav aria-label="Contents" class="mb-12 border-y border-border py-5">
          <p class="mb-3 font-mono text-xs tracking-wide text-muted-foreground">
            CONTENTS
          </p>
          <ol class="space-y-1.5">
            {sections.map(s => (
              <li>
                <a
                  href={`#${s.slug}`}
                  class="text-[0.95rem] text-muted-foreground underline decoration-transparent underline-offset-4 transition-colors hover:text-foreground hover:decoration-border"
                >
                  {s.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <article class="prose article-prose max-w-none">
      <Content />
    </article>
  </main>
</Layout>
