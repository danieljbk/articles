---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Search" description="Search across articles.kwon.ai.">
  <main class="mx-auto w-full max-w-2xl flex-1 px-6 py-16">
    <header class="mb-10">
      <h1 class="text-3xl font-semibold tracking-tight">search</h1>
      <p class="mt-3 text-balance text-muted-foreground">
        Full-text search across every article. Powered by Pagefind.
      </p>
    </header>

    <div id="search"></div>
  </main>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script
    is:inline
    define:vars={{ initialQuery: Astro.url.searchParams.get("q") }}
  >
    // Re-initialize Pagefind UI on every page-load. With ClientRouter, the
    // search page can be re-entered without a full reload — astro:page-load
    // fires for both fresh loads and client-side navigations.
    function initSearch() {
      const target = document.querySelector("#search");
      if (!target || target.dataset.pagefindAttached === "true") return;
      if (typeof window.PagefindUI === "undefined") return;
      target.dataset.pagefindAttached = "true";
      // eslint-disable-next-line no-new
      new window.PagefindUI({
        element: "#search",
        showImages: false,
        showSubResults: true,
        excerptLength: 22,
        resetStyles: false,
      });
      if (initialQuery) {
        const input = document.querySelector("#search input[type='text']");
        if (input) {
          input.value = initialQuery;
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }
      }
    }

    document.addEventListener("astro:page-load", initSearch);
  </script>
</Layout>
