---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { toUrlSlug } from "@/utils/slug";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout>
  <main class="mx-auto w-full max-w-2xl flex-1 px-6 py-16">
    <header class="mb-14">
      <h1 class="text-3xl font-semibold tracking-tight">articles</h1>
      <p class="mt-3 text-balance text-muted-foreground">
        Research notes, technical writeups, and references by Daniel Kwon.
      </p>
    </header>

    {
      articles.length === 0 ? (
        <p class="text-muted-foreground">No articles yet.</p>
      ) : (
        <ul class="divide-y divide-border border-y border-border">
          {articles.map(article => (
            <li>
              <a
                href={`/${toUrlSlug(article.id)}`}
                class="group flex flex-col gap-1.5 py-5 transition-colors hover:bg-secondary/40 sm:-mx-4 sm:px-4"
              >
                <div class="flex items-baseline justify-between gap-4">
                  <span class="font-medium tracking-tight group-hover:text-foreground">
                    {article.data.title}
                  </span>
                  <time
                    datetime={article.data.pubDate.toISOString().slice(0, 10)}
                    class="shrink-0 font-mono text-xs text-muted-foreground"
                  >
                    {dateFormatter.format(article.data.pubDate)}
                  </time>
                </div>
                <p class="line-clamp-2 text-sm text-muted-foreground">
                  {article.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
