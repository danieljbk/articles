---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="404 · Not found"
  description="The page you were looking for does not exist."
>
  <main class="mx-auto flex w-full max-w-2xl flex-1 flex-col px-6 py-24">
    <header>
      <p class="font-mono text-sm text-muted-foreground">404</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Not found</h1>
      <p class="mt-3 text-balance text-muted-foreground">
        The page you're looking for doesn't exist on
        <code class="font-mono text-foreground">articles.kwon.ai</code>.
      </p>
    </header>

    <div class="mt-8">
      <a
        href="/"
        class="text-sm underline decoration-border underline-offset-4 hover:decoration-foreground"
      >
        ← Back to articles
      </a>
    </div>
  </main>
</Layout>
