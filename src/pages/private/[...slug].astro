---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { splitPrivateId } from "@/utils/slug";
import ExposurePanel from "@/components/ExposurePanel.astro";
import Connections from "@/components/Connections.astro";
import ExportDialog from "@/components/ExportDialog.astro";
import TagList from "@/components/TagList.astro";
import { getConnections } from "@/utils/links";

type Props = { article: CollectionEntry<"private">; status: string };

export const getStaticPaths: GetStaticPaths = async () => {
  // Runs on EVERY build, including production where no private paths are
  // emitted. Placing this after the early return below would mean the guard
  // only fired locally, which is the half that does not matter.
  const all = await getCollection("private", ({ data }) => !data.draft);
  for (const a of all) {
    const { status } = splitPrivateId(a.id);
    if (status !== "drafts" && !a.data.exposure) {
      throw new Error(
        `${a.id} has no exposure assessment. Every finished private article needs ` +
        `one — add an "exposure" block, or move it to drafts/ while it is in progress.`
      );
    }
  }

  if (process.env.INCLUDE_PRIVATE !== "1") return [];
  const articles = all;
  return articles.map(article => {
    const { status, slug } = splitPrivateId(article.id);
    return { params: { slug: `${status}/${slug}` }, props: { article, status } };
  });
};

const { article, status } = Astro.props as Props;
const { Content, headings } = await render(article);

// Long pieces get a contents list. Sections only (h2); anything shorter
// than five sections navigates fine by scrolling.
const sections = headings.filter(h => h.depth === 2);
const showToc = sections.length >= 5;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const isoDate = article.data.pubDate.toISOString().slice(0, 10);

const { slug: ownSlug } = splitPrivateId(article.id);

// Vault content must not leave the machine by ANY route. The schema guard
// stops it reaching the public collection; export to PDF is a second, entirely
// separate disclosure path that guard never covered. No button, no dialog.
const isVault = article.data.vault;

const connections = await getConnections(
  ownSlug,
  article.data.session,
  article.data.related
);
---

<Layout title={article.data.title} description={article.data.description}>
  {isVault && <style is:inline>{`@media print { body { display: none !important } }`}</style>}
  <main class="mx-auto w-full max-w-2xl flex-1 px-6 py-12">
    <header class="mb-10">
      <div class="flex items-center gap-3" data-print-hide>
        <time datetime={isoDate} class="font-mono text-sm text-muted-foreground">
          {dateFormatter.format(article.data.pubDate)}
        </time>

        {/* Status only when it is NOT the default. Every private article used to
            carry both a "private" and a "completed" pill — the first is implied
            by the URL and the nav, the second is true of the large majority, so
            neither carried information. Silence is the signal for "ordinary". */}
        {
          status !== "completed" && (
            <span
              class:list={[
                "font-mono text-xs uppercase tracking-[0.14em]",
                isVault ? "text-destructive" : "text-muted-foreground",
              ]}
            >
              {status}
            </span>
          )
        }

        {isVault ? (
          <span class="ml-auto inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.14em] text-destructive" title="Vault content cannot be exported">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-3.5 w-3.5" aria-hidden="true">
              <rect x="3" y="11" width="18" height="11" rx="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            no export
          </span>
        ) : (
        <button
          type="button"
          id="print-article"
          class="chrome-action ml-auto"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
            <path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" />
          </svg>
          Save as PDF
        </button>
        )}
      </div>
      <time
        datetime={isoDate}
        class="hidden font-mono text-sm text-muted-foreground print:block"
      >
        {dateFormatter.format(article.data.pubDate)}
      </time>
      <h1
        class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl"
      >
        {article.data.title}
      </h1>
      <p class="mt-3 text-lg text-muted-foreground">
        {article.data.description}
      </p>
    <TagList tags={article.data.tags} />
    </header>

    {article.data.exposure && <ExposurePanel exposure={article.data.exposure} />}

    {
      showToc && (
        <nav aria-label="Contents" class="mb-12 border-y border-border py-5">
          <p class="mb-3 font-mono text-xs tracking-wide text-muted-foreground">
            CONTENTS
          </p>
          <ol class="space-y-1.5">
            {sections.map((s, i) => (
              <li>
                <a
                  href={`#${s.slug}`}
                  class="text-[0.95rem] text-muted-foreground underline decoration-transparent underline-offset-4 transition-colors hover:text-foreground hover:decoration-border"
                >
                  <span class="tabular-nums">{i + 1}.</span> {s.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <article class="prose article-prose max-w-none">
      <Content />
    </article>

    <Connections {...connections} session={article.data.session} />

    {!isVault && <ExportDialog exposure={article.data.exposure} title={article.data.title} />}
  </main>

  <script is:inline>
    // Print is the export path: the browser's own "Save as PDF" destination
    // produces the document. No library, no server-side rendering step.
    // Export is gated on seeing the exposure assessment. The dialog blocks,
    // and only an explicit "Export as PDF" reaches window.print().
    const dlg = document.getElementById("export-dialog");
    document.getElementById("print-article")?.addEventListener("click", () => dlg?.showModal());
    dlg?.addEventListener("close", () => {
      if (dlg.returnValue === "export") window.print();
    });
  </script>
</Layout>
