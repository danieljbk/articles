---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { splitPrivateId } from "@/utils/slug";
import ExposurePanel from "@/components/ExposurePanel.astro";
import Connections from "@/components/Connections.astro";
import ExportDialog from "@/components/ExportDialog.astro";
import { getConnections } from "@/utils/links";

type Props = { article: CollectionEntry<"private">; status: string };

export const getStaticPaths: GetStaticPaths = async () => {
  if (process.env.INCLUDE_PRIVATE !== "1") return [];
  const articles = await getCollection("private", ({ data }) => !data.draft);
  return articles.map(article => {
    const { status, slug } = splitPrivateId(article.id);
    return { params: { slug: `${status}/${slug}` }, props: { article, status } };
  });
};

const { article, status } = Astro.props as Props;
const { Content, headings } = await render(article);

// Long pieces get a contents list. Sections only (h2); anything shorter
// than five sections navigates fine by scrolling.
const sections = headings.filter(h => h.depth === 2);
const showToc = sections.length >= 5;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const isoDate = article.data.pubDate.toISOString().slice(0, 10);

const { slug: ownSlug } = splitPrivateId(article.id);
const connections = await getConnections(
  ownSlug,
  article.data.session,
  article.data.related
);
---

<Layout title={article.data.title} description={article.data.description}>
  <main class="mx-auto w-full max-w-2xl flex-1 px-6 py-12">
    <header class="mb-10">
      <div class="flex items-center gap-3" data-print-hide>
        <time
          datetime={isoDate}
          class="font-mono text-sm text-muted-foreground"
        >
          {dateFormatter.format(article.data.pubDate)}
        </time>
        <span
          class="rounded-md border border-border bg-secondary px-2 py-0.5 font-mono text-xs uppercase tracking-wide text-muted-foreground"
        >
          private
        </span>
        <span
          class="rounded-md border border-border bg-secondary px-2 py-0.5 font-mono text-xs uppercase tracking-wide text-muted-foreground"
        >
          {status}
        </span>
        <button
          type="button"
          id="print-article"
          class="ml-auto rounded-md border border-border bg-secondary px-2 py-0.5 font-mono text-xs uppercase tracking-wide text-muted-foreground transition-colors hover:text-foreground"
        >
          save as pdf
        </button>
      </div>
      <time
        datetime={isoDate}
        class="hidden font-mono text-sm text-muted-foreground print:block"
      >
        {dateFormatter.format(article.data.pubDate)}
      </time>
      <h1
        class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl"
      >
        {article.data.title}
      </h1>
      <p class="mt-3 text-lg text-muted-foreground">
        {article.data.description}
      </p>
      {
        article.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {article.data.tags.map(tag => (
              <span class="rounded-md border border-border bg-secondary px-2 py-0.5 font-mono text-xs text-muted-foreground">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    {article.data.exposure && <ExposurePanel exposure={article.data.exposure} />}

    {
      showToc && (
        <nav aria-label="Contents" class="mb-12 border-y border-border py-5">
          <p class="mb-3 font-mono text-xs tracking-wide text-muted-foreground">
            CONTENTS
          </p>
          <ol class="space-y-1.5">
            {sections.map((s, i) => (
              <li>
                <a
                  href={`#${s.slug}`}
                  class="text-[0.95rem] text-muted-foreground underline decoration-transparent underline-offset-4 transition-colors hover:text-foreground hover:decoration-border"
                >
                  <span class="tabular-nums">{i + 1}.</span> {s.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <article class="prose article-prose max-w-none">
      <Content />
    </article>

    <Connections {...connections} session={article.data.session} />

    <ExportDialog exposure={article.data.exposure} title={article.data.title} />
  </main>

  <script is:inline>
    // Print is the export path: the browser's own "Save as PDF" destination
    // produces the document. No library, no server-side rendering step.
    // Export is gated on seeing the exposure assessment. The dialog blocks,
    // and only an explicit "Export as PDF" reaches window.print().
    const dlg = document.getElementById("export-dialog");
    document.getElementById("print-article")?.addEventListener("click", () => dlg?.showModal());
    dlg?.addEventListener("close", () => {
      if (dlg.returnValue === "export") window.print();
    });
  </script>
</Layout>
