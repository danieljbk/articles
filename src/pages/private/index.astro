---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { splitPrivateId } from "@/utils/slug";

const isLocal = process.env.INCLUDE_PRIVATE === "1";

const articles = isLocal
  ? (await getCollection("private", ({ data }) => !data.draft)).sort(
      (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
    )
  : [];

// Completed pieces are the ones worth re-reading, so they lead. Drafts are
// working passes kept for the record.
const groups = (["completed", "drafts"] as const).map(status => ({
  status,
  blurb:
    status === "completed"
      ? "Finished pieces, kept to be re-read. These carry the original wording verbatim."
      : "Working passes and superseded material.",
  items: articles
    .map(article => ({ article, ...splitPrivateId(article.id) }))
    .filter(entry => entry.status === status),
}));

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title="Private"
  description="Local-only archive of unpublished articles."
>
  <main class="mx-auto w-full max-w-2xl flex-1 px-6 py-16">
    <header class="mb-14">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-semibold tracking-tight">private</h1>
        <span
          class="rounded-md border border-border bg-secondary px-2 py-0.5 font-mono text-xs uppercase tracking-wide text-muted-foreground"
        >
          local-only
        </span>
      </div>
      <p class="mt-3 max-w-md text-balance text-muted-foreground">
        Articles in <code class="rounded bg-secondary px-1 font-mono text-xs"
          >../articles-private/</code
        >, split into <code class="rounded bg-secondary px-1 font-mono text-xs"
          >completed/</code
        > and <code class="rounded bg-secondary px-1 font-mono text-xs"
          >drafts/</code
        >. Visible only when the site is run locally.
      </p>
    </header>

    {
      !isLocal ? (
        <p class="text-muted-foreground">
          Private content is hidden in production. Run{" "}
          <code class="rounded bg-secondary px-1 font-mono text-xs">
            bun run dev:private
          </code>{" "}
          locally to browse.
        </p>
      ) : articles.length === 0 ? (
        <p class="text-muted-foreground">No private articles yet.</p>
      ) : (
        groups
          .filter(group => group.items.length > 0)
          .map(group => (
            <section class="mb-14">
              <div class="mb-4 flex items-baseline gap-3">
                <h2 class="font-mono text-sm uppercase tracking-wide text-foreground">
                  {group.status}
                </h2>
                <span class="font-mono text-xs text-muted-foreground">
                  {group.items.length}
                </span>
              </div>
              <p class="mb-5 text-sm text-muted-foreground">{group.blurb}</p>
              <ul class="divide-y divide-border border-y border-border">
                {group.items.map(({ article, status, slug }) => (
                  <li>
                    <a
                      href={`/private/${status}/${slug}`}
                      class="group flex flex-col gap-1.5 py-5 transition-colors hover:bg-secondary/40 sm:-mx-4 sm:px-4"
                    >
                      <div class="flex items-baseline justify-between gap-4">
                        <span class="font-medium tracking-tight group-hover:text-foreground">
                          {article.data.title}
                        </span>
                        <time
                          datetime={article.data.pubDate.toISOString().slice(0, 10)}
                          class="shrink-0 font-mono text-xs text-muted-foreground"
                        >
                          {dateFormatter.format(article.data.pubDate)}
                        </time>
                      </div>
                      <p class="line-clamp-2 text-sm text-muted-foreground">
                        {article.data.description}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
      )
    }
  </main>
</Layout>
