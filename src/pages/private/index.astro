---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ArticleRow from "@/components/ArticleRow.astro";
import { splitPrivateId } from "@/utils/slug";
import LineChart from "@components/LineChart.astro";
import {
  claudeMdStats,
  dayIndex,
  readBoards,
  readDerived,
  readTelemetry,
  rebuildDiffStats,
  stepSeries,
} from "@/utils/suite";

const isLocal = process.env.INCLUDE_PRIVATE === "1";

// Dashboard readouts — all machine-local, all live per request in dev.
const cm = claudeMdStats();
const diff = rebuildDiffStats();
const boards = readBoards();
const telemetry = readTelemetry();
const activeBoards = boards.filter(b => b.status === "active");
const openItems = activeBoards.reduce((n, b) => n + b.open, 0);
const lastTel = telemetry[0];
const cmPct = cm ? (cm.chars / cm.budget) * 100 : 0;
const nearCap = cmPct > 95;

const derived = readDerived();
const daily = derived?.claude_md.daily ?? [];
const epoch = daily[0]?.date ?? "";
const lastDay = daily[daily.length - 1];
const todayUtc = new Date().toISOString().slice(0, 10);
const deltaToday = lastDay?.date === todayUtc ? lastDay.delta : 0;
const span = lastDay ? dayIndex(lastDay.date, epoch) : 0;
const sizePts = stepSeries(daily, epoch, 1000);
const maxK = Math.max(...daily.map(d => d.chars), 100_000) / 1000;

const BOARD_MARK: Record<string, { glyph: string; cls: string }> = {
  done: { glyph: "✓", cls: "text-safe" },
  doing: { glyph: "▶", cls: "text-caution" },
  todo: { glyph: "○", cls: "text-muted-foreground" },
  waits: { glyph: "◆", cls: "text-caution" },
};

const articles = isLocal
  ? (await getCollection("private", ({ data }) => !data.draft)).sort(
      (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
    )
  : [];

// Grouped by session — the conversation a piece was written in — rather than
// by status. Status is a property of one article; session is what makes a
// hundred articles navigable, because it is how they were actually produced
// and therefore how they are remembered. Articles predating the session field
// fall back to their date, so nothing is orphaned.
const entries = articles.map(article => {
  const { status, slug } = splitPrivateId(article.id);
  const session =
    article.data.session ?? article.data.pubDate.toISOString().slice(0, 10);
  return { article, status, slug, session };
});

const sessions = [...new Set(entries.map(e => e.session))]
  .sort()
  .reverse()
  .map(session => {
    const items = entries.filter(e => e.session === session);
    const iso = session.slice(0, 10);
    return {
      session,
      // The theme half of "YYYY-MM-DD-theme"; empty for date-only fallbacks.
      theme: session.slice(11).replace(/-/g, " "),
      date: new Date(`${iso}T00:00:00Z`),
      items,
    };
  });

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title="Dashboard"
  description="The local tool suite and private article archive."
>
  <main class="mx-auto w-full max-w-2xl flex-1 px-6 py-16">
    <header class="mb-14">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-semibold tracking-tight">dashboard</h1>
        <span class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground/70">
          local-only
        </span>
      </div>
      <p class="mt-3 max-w-md text-balance text-muted-foreground">
        The tool suite: live displays to check at any time, then the private
        article archive grouped by the conversation each piece was written in.
        Visible only when the site is run locally.
      </p>
    </header>

    {
      isLocal && (
        <section class="mb-14">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <a
              href="/private/tools/claude-md"
              class="rounded-lg border p-4 transition-colors hover:bg-secondary/40"
            >
              <div class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground">
                CLAUDE.md budget
              </div>
              <div class="mt-1 text-2xl font-semibold tabular-nums tracking-tight">
                {cm ? `${Math.round(cmPct * 10) / 10}%` : "—"}
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-secondary">
                <div
                  class:list={["h-full rounded-full", nearCap ? "bg-caution" : "bg-foreground"]}
                  style={`width:${Math.min(cmPct, 100)}%`}
                />
              </div>
              <div
                class:list={[
                  "mt-1.5 font-mono text-[0.7rem]",
                  nearCap ? "text-caution" : "text-muted-foreground",
                ]}
              >
                {cm
                  ? `${cm.chars.toLocaleString()} of ${cm.budget.toLocaleString()}${
                      deltaToday
                        ? ` · ${deltaToday > 0 ? "+" : ""}${deltaToday.toLocaleString()} today`
                        : ""
                    }${nearCap ? " · near cap" : ""}`
                  : "unavailable"}
              </div>
            </a>

            <a
              href="/private/tools/rebuild-diff"
              class="rounded-lg border border-caution/50 p-4 transition-colors hover:bg-secondary/40"
            >
              <div class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground">
                awaiting your ruling
              </div>
              <div class="mt-1 text-2xl font-semibold tabular-nums tracking-tight text-caution">
                {diff?.pending ?? "—"}
              </div>
              <div class="mt-1.5 font-mono text-[0.7rem] text-muted-foreground">
                amber diff items · {diff?.executed ?? "—"} executed
              </div>
            </a>

            <a
              href="/private/tools/sessions"
              class="rounded-lg border p-4 transition-colors hover:bg-secondary/40"
            >
              <div class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground">
                open across sessions
              </div>
              <div class="mt-1 text-2xl font-semibold tabular-nums tracking-tight">
                {openItems}
              </div>
              <div class="mt-1.5 font-mono text-[0.7rem] text-muted-foreground">
                {activeBoards.length} active board{activeBoards.length === 1 ? "" : "s"}
              </div>
            </a>

            <a
              href="/private/tools/telemetry"
              class="rounded-lg border p-4 transition-colors hover:bg-secondary/40"
            >
              <div class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground">
                last session signals
              </div>
              <div class="mt-1 text-2xl font-semibold tabular-nums tracking-tight">
                {lastTel ? `${lastTel.signals?.corrections ?? 0} / ${lastTel.signals?.validations ?? 0}` : "—"}
              </div>
              <div class="mt-1.5 font-mono text-[0.7rem] text-muted-foreground">
                {lastTel ? "corrections / validations" : "no records yet"}
              </div>
            </a>
          </div>

          {
            daily.length > 1 && (
              <div class="mt-6 rounded-lg border p-5">
                <div class="flex items-baseline gap-3">
                  <span class="font-medium">CLAUDE.md over time</span>
                  <a
                    href="/private/tools/telemetry"
                    class="ml-auto shrink-0 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground hover:text-foreground"
                  >
                    telemetry →
                  </a>
                </div>
                <LineChart
                  title="CLAUDE.md size in thousands of characters over time, with the flat 100K budget marked"
                  series={[{ points: sizePts }]}
                  xDomain={[0, span + 6]}
                  yDomain={[60, Math.ceil(maxK / 10) * 10 + 10]}
                  xTicks={[0, 30, 60, 90, span]}
                  yTicks={[60, 100, 140]}
                  xLabel={`days since ${epoch}`}
                  ySuffix="K"
                  refLines={[{ y: 100, label: "budget" }]}
                  height={200}
                />
              </div>
            )
          }

          {
            activeBoards.map(b => (
              <div class="mt-6 rounded-lg border border-caution/50 p-5">
                <div class="flex items-baseline gap-3">
                  <span class="font-medium">{b.title}</span>
                  <a
                    href="/private/tools/sessions"
                    class="ml-auto shrink-0 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-caution"
                  >
                    live board →
                  </a>
                </div>
                <ul class="mt-3 space-y-1">
                  {b.items
                    .filter(i => i.state !== "done")
                    .map(i => (
                      <li class="flex gap-3 text-sm">
                        <span
                          class:list={["w-4 shrink-0 text-center font-mono", BOARD_MARK[i.state].cls]}
                        >
                          {BOARD_MARK[i.state].glyph}
                        </span>
                        <span class:list={[i.state === "waits" && "text-caution"]}>
                          {i.text}
                        </span>
                      </li>
                    ))}
                  <li class="flex gap-3 text-sm text-muted-foreground">
                    <span class="w-4 shrink-0 text-center font-mono text-safe">✓</span>
                    <span>
                      {b.items.filter(i => i.state === "done").length} done — full
                      list on the board
                    </span>
                  </li>
                </ul>
              </div>
            ))
          }
        </section>
      )
    }

    {
      !isLocal ? (
        <p class="text-muted-foreground">
          Private content is hidden in production. Run{" "}
          <code class="rounded bg-secondary px-1 font-mono text-xs">
            bun run dev:private
          </code>{" "}
          locally to browse.
        </p>
      ) : articles.length === 0 ? (
        <p class="text-muted-foreground">No private articles yet.</p>
      ) : (
        sessions.map(group => (
          <section class="mb-12">
            <div class="mb-4 flex items-baseline gap-3 border-b border-border pb-2">
              <time
                datetime={group.session.slice(0, 10)}
                class="font-mono text-sm text-foreground"
              >
                {dateFormatter.format(group.date)}
              </time>
              {group.theme && (
                <span class="font-mono text-xs uppercase tracking-wide text-muted-foreground">
                  {group.theme}
                </span>
              )}
              <span class="ml-auto font-mono text-xs text-muted-foreground">
                {group.items.length}
              </span>
            </div>
            <ul class="divide-y divide-border">
              {group.items.map(({ article, status, slug }) => (
                <li>
                  <ArticleRow
                    href={`/private/${status}/${slug}`}
                    title={article.data.title}
                    description={article.data.description}
                    dense
                  >
                    {status !== "completed" && (
                      <span
                        slot="meta"
                        class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-foreground/70"
                      >
                        {status}
                      </span>
                    )}
                  </ArticleRow>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </main>
</Layout>
