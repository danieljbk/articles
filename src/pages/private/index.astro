---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { splitPrivateId } from "@/utils/slug";

const isLocal = process.env.INCLUDE_PRIVATE === "1";

const articles = isLocal
  ? (await getCollection("private", ({ data }) => !data.draft)).sort(
      (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
    )
  : [];

// Grouped by session — the conversation a piece was written in — rather than
// by status. Status is a property of one article; session is what makes a
// hundred articles navigable, because it is how they were actually produced
// and therefore how they are remembered. Articles predating the session field
// fall back to their date, so nothing is orphaned.
const entries = articles.map(article => {
  const { status, slug } = splitPrivateId(article.id);
  const session =
    article.data.session ?? article.data.pubDate.toISOString().slice(0, 10);
  return { article, status, slug, session };
});

const sessions = [...new Set(entries.map(e => e.session))]
  .sort()
  .reverse()
  .map(session => {
    const items = entries.filter(e => e.session === session);
    const iso = session.slice(0, 10);
    return {
      session,
      // The theme half of "YYYY-MM-DD-theme"; empty for date-only fallbacks.
      theme: session.slice(11).replace(/-/g, " "),
      date: new Date(`${iso}T00:00:00Z`),
      items,
    };
  });

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title="Private"
  description="Local-only archive of unpublished articles."
>
  <main class="mx-auto w-full max-w-2xl flex-1 px-6 py-16">
    <header class="mb-14">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-semibold tracking-tight">private</h1>
        <span class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground/70">
          local-only
        </span>
      </div>
      <p class="mt-3 max-w-md text-balance text-muted-foreground">
        Articles in <code class="rounded bg-secondary px-1 font-mono text-xs"
          >../articles-private/</code
        >, grouped by the conversation they were written in. Visible only when
        the site is run locally.
      </p>
    </header>

    {
      !isLocal ? (
        <p class="text-muted-foreground">
          Private content is hidden in production. Run{" "}
          <code class="rounded bg-secondary px-1 font-mono text-xs">
            bun run dev:private
          </code>{" "}
          locally to browse.
        </p>
      ) : articles.length === 0 ? (
        <p class="text-muted-foreground">No private articles yet.</p>
      ) : (
        sessions.map(group => (
          <section class="mb-12">
            <div class="mb-4 flex items-baseline gap-3 border-b border-border pb-2">
              <time
                datetime={group.session.slice(0, 10)}
                class="font-mono text-sm text-foreground"
              >
                {dateFormatter.format(group.date)}
              </time>
              {group.theme && (
                <span class="font-mono text-xs uppercase tracking-wide text-muted-foreground">
                  {group.theme}
                </span>
              )}
              <span class="ml-auto font-mono text-xs text-muted-foreground">
                {group.items.length}
              </span>
            </div>
            <ul class="divide-y divide-border">
              {group.items.map(({ article, status, slug }) => (
                <li>
                  <a
                    href={`/private/${status}/${slug}`}
                    class="group flex flex-col gap-1.5 py-4 transition-colors hover:bg-secondary/40 sm:-mx-4 sm:px-4"
                  >
                    <div class="flex items-baseline justify-between gap-4">
                      <span class="font-medium tracking-tight">
                        {article.data.title}
                      </span>
                      {status !== "completed" && (
                        <span class="shrink-0 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-foreground/70">
                          {status}
                        </span>
                      )}
                    </div>
                    <p class="line-clamp-2 text-sm text-muted-foreground">
                      {article.data.description}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </main>
</Layout>
