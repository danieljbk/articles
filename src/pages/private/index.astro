---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ArticleRow from "@/components/ArticleRow.astro";
import { splitPrivateId } from "@/utils/slug";
import LineChart from "@components/LineChart.astro";
import type { BoardItem } from "@/utils/suite";
import {
  breakTickLabels,
  claudeMdStats,
  compressedStepSeries,
  readBoards,
  readDerived,
  readTelemetry,
  rebuildDiffStats,
} from "@/utils/suite";

const isLocal = process.env.INCLUDE_PRIVATE === "1";

// Dashboard readouts — all machine-local, all live per request in dev.
const cm = claudeMdStats();
const diff = rebuildDiffStats();
const boards = readBoards();
const telemetry = readTelemetry();
const activeBoards = boards.filter(b => b.status === "active");

// Mission control separates what awaits the decider from what is merely
// running, so those never share a column here. Board items are written as full
// paragraphs by the sessions that own them, so each shows as one clamped line
// with the prose one level down on the sessions route, which is where the
// detail belongs.
type FlatItem = { state: BoardItem["state"]; text: string; board: string };
const flatItems: FlatItem[] = activeBoards.flatMap(b =>
  b.items.map(i => ({ state: i.state, text: i.text, board: b.title }))
);
const COLUMNS = [
  { key: "waits" as const, label: "awaiting your ruling" },
  { key: "doing" as const, label: "in flight" },
  { key: "todo" as const, label: "queued" },
].map(c => ({ ...c, items: flatItems.filter(i => i.state === c.key) }));
const doneCount = flatItems.filter(i => i.state === "done").length;
const COLUMN_CAP = 6;
const openItems = activeBoards.reduce((n, b) => n + b.open, 0);
const lastTel = telemetry[0];
// Against the target, not the hard stop: the target is the number a version
// pass has to reach, so that is the bar worth reading at a glance. Over it is
// "pass due", not a failure — writes keep landing until the hard stop.
const cmPct = cm ? (cm.tokens / cm.target) * 100 : 0;
const overTarget = !!cm && cm.tokens > cm.target;
const cmState = !cm
  ? "unavailable"
  : cm.tokens > cm.hardStop
    ? "writes refused"
    : cm.tokens > cm.warn
      ? "pass due"
      : overTarget
        ? "over target"
        : "under target";

const derived = readDerived();
const daily = derived?.claude_md.daily ?? [];
const { pts: sizePts, breaks: sizeBreaks, span: sizeSpan, xOf } =
  compressedStepSeries(daily, 1000);
const sizeTicks = breakTickLabels(daily, xOf);
const maxK = Math.max(...daily.map(d => d.chars), 100_000) / 1000;

// readDerived() refreshes anything older than 10 minutes and serves the last
// derivation when the refresh fails — so an age beyond 15 minutes means the
// pipeline is broken, and stale data must not render as current (the
// NASA-display rule: staleness is a first-class visual state).
const derivedAgeMin = derived
  ? Math.round((Date.now() - Date.parse(derived.generated_at)) / 60_000)
  : null;
const derivedStale = derivedAgeMin !== null && derivedAgeMin > 15;

const TOOL_LINKS = [
  { href: "/private/tools/claude-md", label: "claude.md" },
  { href: "/private/tools/rebuild-diff", label: "rebuild-diff" },
  { href: "/private/tools/sessions", label: "sessions" },
  { href: "/private/tools/telemetry", label: "telemetry" },
  { href: "/private/tools/reports", label: "reports" },
];

const BOARD_MARK: Record<string, { glyph: string; cls: string }> = {
  done: { glyph: "✓", cls: "text-safe" },
  doing: { glyph: "▶", cls: "text-caution" },
  todo: { glyph: "○", cls: "text-muted-foreground" },
  waits: { glyph: "◆", cls: "text-caution" },
};

const articles = isLocal
  ? (await getCollection("private", ({ data }) => !data.draft)).sort(
      (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
    )
  : [];

// Grouped by session — the conversation a piece was written in — rather than
// by status. Status is a property of one article; session is what makes a
// hundred articles navigable, because it is how they were actually produced
// and therefore how they are remembered. Articles predating the session field
// fall back to their date, so nothing is orphaned.
const entries = articles.map(article => {
  const { status, slug } = splitPrivateId(article.id);
  const session =
    article.data.session ?? article.data.pubDate.toISOString().slice(0, 10);
  return { article, status, slug, session };
});

const sessions = [...new Set(entries.map(e => e.session))]
  .sort()
  .reverse()
  .map(session => {
    const items = entries.filter(e => e.session === session);
    const iso = session.slice(0, 10);
    return {
      session,
      // The theme half of "YYYY-MM-DD-theme"; empty for date-only fallbacks.
      theme: session.slice(11).replace(/-/g, " "),
      date: new Date(`${iso}T00:00:00Z`),
      items,
    };
  });

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title="Dashboard"
  description="The local tool suite and private article archive."
  wide={isLocal}
>
  <main
    class:list={[
      "mx-auto w-full flex-1 px-6",
      isLocal ? "max-w-6xl py-10" : "max-w-2xl py-16",
    ]}
  >
    {
      isLocal ? (
        <header class="mb-8 flex flex-wrap items-baseline gap-x-4 gap-y-2">
          <h1 class="text-xl font-semibold tracking-tight">dashboard</h1>
          <span class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-muted-foreground/70">
            local-only · live per request
          </span>
          <nav class="ml-auto flex flex-wrap gap-x-4 gap-y-1 font-mono text-[0.7rem] uppercase tracking-[0.12em] text-muted-foreground">
            {TOOL_LINKS.map(t => (
              <a class="hover:text-foreground" href={t.href}>
                {t.label}
              </a>
            ))}
          </nav>
        </header>
      ) : (
        <header class="mb-14">
          <h1 class="text-3xl font-semibold tracking-tight">Private</h1>
        </header>
      )
    }

    {
      isLocal && (
        <section class="mb-14 grid grid-cols-2 gap-3 lg:grid-cols-12">
          <a
            href="/private/tools/claude-md"
            class="rounded-lg border p-4 transition-colors hover:bg-secondary/40 lg:col-span-3"
          >
            <div class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground">
              CLAUDE.md budget
            </div>
            <div class="mt-1 text-2xl font-semibold tabular-nums tracking-tight">
              {cm ? `${cm.tokens.toLocaleString()}` : "—"}
              <span class="text-sm font-normal text-muted-foreground">tokens</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-secondary">
              <div
                class:list={["h-full rounded-full", overTarget ? "bg-caution" : "bg-foreground"]}
                style={`width:${Math.min(cmPct, 100)}%`}
              />
            </div>
            <div
              class:list={[
                "mt-1.5 font-mono text-[0.7rem]",
                overTarget ? "text-caution" : "text-muted-foreground",
              ]}
            >
              {cm
                ? `${cmState} of ${cm.target.toLocaleString()}`
                : "unavailable"}
            </div>
          </a>

          <a
            href="/private/tools/rebuild-diff"
            class="rounded-lg border border-caution/50 p-4 transition-colors hover:bg-secondary/40 lg:col-span-3"
          >
            <div class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground">
              awaiting your ruling
            </div>
            <div class="mt-1 text-2xl font-semibold tabular-nums tracking-tight text-caution">
              {diff?.pending ?? "—"}
            </div>
            <div class="mt-1.5 font-mono text-[0.7rem] text-muted-foreground">
              amber diff items · {diff?.executed ?? "—"} executed
            </div>
          </a>

          <a
            href="/private/tools/sessions"
            class="rounded-lg border p-4 transition-colors hover:bg-secondary/40 lg:col-span-3"
          >
            <div class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground">
              open across sessions
            </div>
            <div class="mt-1 text-2xl font-semibold tabular-nums tracking-tight">
              {openItems}
            </div>
            <div class="mt-1.5 font-mono text-[0.7rem] text-muted-foreground">
              {activeBoards.length} active board{activeBoards.length === 1 ? "" : "s"}
            </div>
          </a>

          <a
            href="/private/tools/telemetry"
            class="rounded-lg border p-4 transition-colors hover:bg-secondary/40 lg:col-span-3"
          >
            <div class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground">
              last session signals
            </div>
            <div class="mt-1 text-2xl font-semibold tabular-nums tracking-tight">
              {lastTel ? `${lastTel.signals?.corrections ?? 0} / ${lastTel.signals?.validations ?? 0}` : "—"}
            </div>
            <div class="mt-1.5 font-mono text-[0.7rem] text-muted-foreground">
              {lastTel ? "corrections / validations" : "no records yet"}
            </div>
          </a>

          {
            daily.length > 1 && (
              <div class="col-span-2 rounded-lg border p-5 lg:col-span-12">
                <div class="flex items-baseline gap-3">
                  <span class="font-medium">CLAUDE.md over time</span>
                  <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground">
                    characters per change-day · quiet gaps collapsed
                  </span>
                  {derivedStale && (
                    <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-caution">
                      stale · {derivedAgeMin}m old
                    </span>
                  )}
                  <a
                    href="/private/tools/telemetry"
                    class="ml-auto shrink-0 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground hover:text-foreground"
                  >
                    telemetry →
                  </a>
                </div>
                <LineChart
                  title="CLAUDE.md size in thousands of characters per change-day, quiet gaps collapsed"
                  series={[{ points: sizePts }]}
                  xDomain={[0, sizeSpan + 1]}
                  yDomain={[60, Math.ceil(maxK / 10) * 10 + 10]}
                  xTickLabels={sizeTicks}
                  xBreaks={sizeBreaks}
                  yTicks={[60, 100, 140]}
                  ySuffix="K"
                  height={240}
                />
              </div>
            )
          }

          {
            activeBoards.length > 0 && (
              <div class="col-span-2 rounded-lg border p-5 lg:col-span-12">
                <div class="mb-4 flex items-baseline gap-3">
                  <span class="font-medium">Session board</span>
                  <span class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground">
                    {activeBoards.length} active · {doneCount} done
                  </span>
                  <a
                    href="/private/tools/sessions"
                    class="ml-auto shrink-0 font-mono text-[0.65rem] uppercase tracking-[0.12em] text-muted-foreground hover:text-foreground"
                  >
                    full boards →
                  </a>
                </div>
                <div class="grid gap-x-8 gap-y-6 md:grid-cols-3">
                  {COLUMNS.map(col => (
                    <div>
                      <div
                        class:list={[
                          "flex items-baseline gap-2 border-b pb-1.5 font-mono text-[0.65rem] uppercase tracking-[0.12em]",
                          col.key === "waits" ? "border-caution/40 text-caution" : "text-muted-foreground",
                        ]}
                      >
                        <span>{col.label}</span>
                        <span class="ml-auto tabular-nums">{col.items.length}</span>
                      </div>
                      {col.items.length === 0 ? (
                        <p class="mt-2.5 text-sm text-muted-foreground/60">none</p>
                      ) : (
                        <ul class="mt-2.5 space-y-1.5">
                          {col.items.slice(0, COLUMN_CAP).map(i => (
                            <li class="flex gap-2 text-sm">
                              <span
                                class:list={[
                                  "shrink-0 font-mono",
                                  BOARD_MARK[i.state].cls,
                                ]}
                              >
                                {BOARD_MARK[i.state].glyph}
                              </span>
                              <span
                                title={i.text}
                                class:list={[
                                  "line-clamp-1",
                                  col.key === "waits" ? "text-caution" : "text-muted-foreground",
                                ]}
                              >
                                {i.text}
                              </span>
                            </li>
                          ))}
                          {col.items.length > COLUMN_CAP && (
                            <li class="pl-6 font-mono text-xs text-muted-foreground/70">
                              +{col.items.length - COLUMN_CAP} more
                            </li>
                          )}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )
          }

        </section>
      )
    }

    {
      !isLocal ? (
        <p class="text-muted-foreground">
          Private content is hidden in production. Run{" "}
          <code class="rounded bg-secondary px-1 font-mono text-xs">
            bun run dev:private
          </code>{" "}
          locally to browse.
        </p>
      ) : articles.length === 0 ? (
        <p class="text-muted-foreground">No private articles yet.</p>
      ) : (
        <div class="mx-auto w-full max-w-2xl">
          <div class="mb-6 flex items-baseline gap-3 border-b border-border pb-2">
            <h2 class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-foreground">
              archive — by session
            </h2>
            <span class="ml-auto font-mono text-xs text-muted-foreground">
              {articles.length}
            </span>
          </div>
          {sessions.map(group => (
            <section class="mb-12">
              <div class="mb-4 flex items-baseline gap-3 border-b border-border pb-2">
                <time
                  datetime={group.session.slice(0, 10)}
                  class="font-mono text-sm text-foreground"
                >
                  {dateFormatter.format(group.date)}
                </time>
                {group.theme && (
                  <span class="font-mono text-xs uppercase tracking-wide text-muted-foreground">
                    {group.theme}
                  </span>
                )}
                <span class="ml-auto font-mono text-xs text-muted-foreground">
                  {group.items.length}
                </span>
              </div>
              <ul class="divide-y divide-border">
                {group.items.map(({ article, status, slug }) => (
                  <li>
                    <ArticleRow
                      href={`/private/${status}/${slug}`}
                      title={article.data.title}
                      description={article.data.description}
                      dense
                    >
                      {status !== "completed" && (
                        <span
                          slot="meta"
                          class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-foreground/70"
                        >
                          {status}
                        </span>
                      )}
                    </ArticleRow>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )
    }
  </main>
</Layout>
