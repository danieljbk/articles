---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { toUrlSlug } from "@/utils/slug";

type Props = { tag: string; articles: CollectionEntry<"articles">[] };

export const getStaticPaths: GetStaticPaths = async () => {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  const tagMap = new Map<string, CollectionEntry<"articles">[]>();
  for (const article of articles) {
    for (const tag of article.data.tags) {
      const list = tagMap.get(tag) ?? [];
      list.push(article);
      tagMap.set(tag, list);
    }
  }
  return Array.from(tagMap.entries()).map(([tag, list]) => ({
    params: { tag },
    props: {
      tag,
      articles: list.sort(
        (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
      ),
    },
  }));
};

const { tag, articles } = Astro.props as Props;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title={`#${tag}`}
  description={`Articles tagged ${tag} on articles.kwon.ai.`}
>
  <main class="mx-auto w-full max-w-2xl flex-1 px-6 py-16">
    <header class="mb-14">
      <a
        href="/tags"
        class="font-mono text-sm text-muted-foreground hover:text-foreground"
      >
        ← all tags
      </a>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight">
        <span class="font-mono text-muted-foreground">#</span>{tag}
      </h1>
      <p class="mt-3 text-muted-foreground">
        {articles.length} article{articles.length === 1 ? "" : "s"}
      </p>
    </header>

    <ul class="divide-y divide-border border-y border-border">
      {
        articles.map(article => (
          <li>
            <a
              href={`/${toUrlSlug(article.id)}`}
              class="group flex flex-col gap-1.5 py-5 transition-colors hover:bg-secondary/40 sm:-mx-4 sm:px-4"
            >
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-medium tracking-tight group-hover:text-foreground">
                  {article.data.title}
                </span>
                <time
                  datetime={article.data.pubDate.toISOString().slice(0, 10)}
                  class="shrink-0 font-mono text-xs text-muted-foreground"
                >
                  {dateFormatter.format(article.data.pubDate)}
                </time>
              </div>
              <p class="line-clamp-2 text-sm text-muted-foreground">
                {article.data.description}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
