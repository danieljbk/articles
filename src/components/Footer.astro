---
interface Props {
  wide?: boolean;
}
const { wide = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border">
  <div
    class:list={[
      "mx-auto flex items-center justify-between px-6 py-6 text-sm text-muted-foreground",
      wide ? "max-w-6xl" : "max-w-2xl",
    ]}
  >
    <span>© {year} Daniel Kwon</span>
    <a href="https://kwon.ai" class="hover:text-foreground">kwon.ai</a>
  </div>
</footer>
