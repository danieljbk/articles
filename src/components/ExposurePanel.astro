---
/**
 * Exposure assessment for a private article.
 *
 * Sits above the article and reads as a document header, not a widget. Four
 * design rules govern it:
 *
 *   1. The verdict leads. An earlier version listed every threat first and put
 *      the conclusion last, so you had to read the evidence to learn the
 *      answer — the inverse of how this is actually used. The decision is the
 *      headline; threats are the reasoning behind it.
 *   2. Unconditional verdicts are stated, not templated. Rendering "ALWAYS →
 *      never publish" forced a plain judgement through a conditional shape.
 *      It is set flush instead, so a plain judgement also *looks* unlike a
 *      rule table rather than sitting in a rule table with an empty label.
 *   3. One spine. Every labelled row — each rule, the otherwise, each threat —
 *      hangs off a single fixed label column. An earlier version set the
 *      labels inline, so "IF" and "OTHERWISE" were different widths and the
 *      two clauses you are meant to read against each other started in
 *      different places. Nothing floats at the end of a line of unpredictable
 *      length: severity and category both live in the spine, where they form
 *      columns you read down.
 *   4. Three type sizes, no more. 0.7rem mono for every label, 0.9375rem for
 *      everything quiet, 1.0625rem for the answer. Emphasis comes from weight
 *      and colour, never from a fourth size — a panel this small cannot carry
 *      a scale, and the version that tried read as noise.
 *
 * Colour is semantic and traffic-light: green means no action needed, amber
 * means think before acting, red means stop. It is never decorative, and the
 * severity word is always printed alongside it so the signal never depends on
 * colour perception alone. The same mapping drives the header, the border and
 * each threat, so a severity never renders one colour in the summary and
 * another in the row it summarises.
 */
interface Threat {
  category: string;
  threat: string;
  severity: "low" | "moderate" | "high";
  detail: string;
}
interface Verdict {
  rules: { if: string; then: string }[];
  otherwise: string;
}
interface Props {
  exposure: { threats: Threat[]; verdict: Verdict };
}

const { exposure } = Astro.props;
const { threats, verdict } = exposure;

const rank = { low: 1, moderate: 2, high: 3 } as const;
const worst = threats.reduce((m, t) => Math.max(m, rank[t.severity]), 0);
const overall = (["none", "low", "moderate", "high"] as const)[worst];

const sentence = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const conditional = verdict.rules.length > 0;

const TONE = {
  none: { text: "text-safe", border: "border-safe/60" },
  low: { text: "text-safe", border: "border-safe/60" },
  moderate: { text: "text-caution", border: "border-caution/70" },
  high: { text: "text-destructive", border: "border-destructive/70" },
} as const;
const tone = TONE[overall];

// Declared once because the whole point is that every row shares them — two
// copies would drift apart, which is the defect this replaced. 4.5rem clears
// "OTHERWISE", the widest label the panel can produce.
const ROW = "flex items-baseline gap-4";
const SPINE = "w-[4.5rem] shrink-0";
const LABEL = "font-mono text-[0.7rem] uppercase tracking-[0.14em]";
const QUIET = "text-[0.9375rem] text-muted-foreground";
const ANSWER = "text-[1.0625rem] leading-snug text-foreground";
---

<aside
  aria-label="Exposure assessment"
  data-print-hide
  class:list={["mb-14 border-l-2 pl-5", tone.border]}
>
  <p class:list={[LABEL, "text-muted-foreground"]}>
    If published <span class="text-muted-foreground/50">&middot;</span>
    <span class:list={["font-medium", tone.text]}>
      {overall === "none" ? "no risk" : `${overall} risk`}
    </span>
  </p>

  {/* The answer, first. Condition quiet, consequence loud, stacked so the
      break between them is a line break rather than a mid-sentence dash. */}
  {
    conditional ? (
      <dl class="mt-4 space-y-4">
        {verdict.rules.map(r => (
          <div class={ROW}>
            <dt class:list={[SPINE, LABEL, "text-muted-foreground"]}>If</dt>
            <dd class="min-w-0">
              <span class:list={["block leading-snug", QUIET]}>{r.if}</span>
              <span class:list={["mt-0.5 block font-medium", ANSWER]}>{r.then}</span>
            </dd>
          </div>
        ))}
        <div class={ROW}>
          <dt class:list={[SPINE, LABEL, "text-muted-foreground"]}>Otherwise</dt>
          <dd class:list={["min-w-0 font-medium", ANSWER]}>{verdict.otherwise}</dd>
        </div>
      </dl>
    ) : (
      <p class:list={["mt-4 font-semibold tracking-tight", ANSWER]}>
        {sentence(verdict.otherwise)}.
      </p>
    )
  }

  {/* The reasoning, second and quieter. Severity over category in the spine,
      so both are columns you read down — with three threats you see
      HIGH HIGH HIGH at a glance instead of hunting the ends of three titles
      of different lengths. */}
  <div class="mt-5 border-t border-border pt-5">
    {threats.length === 0 ? (
      <p class:list={[QUIET, "text-safe"]}>No threats identified.</p>
    ) : (
      <ol class="space-y-5">
        {threats.map(t => (
          <li class={ROW}>
            <div class:list={[SPINE, LABEL, "leading-snug"]}>
              <span class:list={["block font-medium", TONE[t.severity].text]}>{t.severity}</span>
              <span class="block text-muted-foreground/60">{t.category}</span>
            </div>
            <div class="min-w-0">
              <p class="text-[0.9375rem] font-medium leading-snug text-foreground">{t.threat}</p>
              <p class:list={["mt-1 leading-normal", QUIET]}>{t.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</aside>
