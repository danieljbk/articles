---
/**
 * Exposure assessment for a private article.
 *
 * Sits above the article and reads as a document header, not a widget. Three
 * design rules govern it:
 *
 *   1. The verdict leads. An earlier version listed every threat first and put
 *      the conclusion last, so you had to read the evidence to learn the
 *      answer — the inverse of how this is actually used. The decision is the
 *      headline; threats are the reasoning behind it.
 *   2. Unconditional verdicts are stated, not templated. Rendering "ALWAYS →
 *      never publish" forced a plain judgement through a conditional shape.
 *   3. One spine. Every row in the panel — each rule, the otherwise, each
 *      threat — hangs off a single fixed label column. An earlier version set
 *      the labels inline, so "IF" and "OTHERWISE" were different widths and
 *      the two clauses you are meant to read against each other started at
 *      different places. The condition and its consequence stacked, rather
 *      than run together with an em dash and a weight change mid-sentence.
 *
 * Colour is semantic and traffic-light: green means no action needed, amber
 * means think before acting, red means stop. It is never decorative, and the
 * severity word is always printed alongside it so the signal never depends on
 * colour perception alone. The same mapping drives the header, the border and
 * each threat, so a severity never renders one colour in the summary and
 * another in the row it summarises.
 */
interface Threat {
  category: string;
  threat: string;
  severity: "low" | "moderate" | "high";
  detail: string;
}
interface Verdict {
  rules: { if: string; then: string }[];
  otherwise: string;
}
interface Props {
  exposure: { threats: Threat[]; verdict: Verdict };
}

const { exposure } = Astro.props;
const { threats, verdict } = exposure;

const rank = { low: 1, moderate: 2, high: 3 } as const;
const worst = threats.reduce((m, t) => Math.max(m, rank[t.severity]), 0);
const overall = (["none", "low", "moderate", "high"] as const)[worst];

const sentence = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const conditional = verdict.rules.length > 0;

const TONE = {
  none: { text: "text-safe", border: "border-safe/60" },
  low: { text: "text-safe", border: "border-safe/60" },
  moderate: { text: "text-caution", border: "border-caution/70" },
  high: { text: "text-destructive", border: "border-destructive/70" },
} as const;
const tone = TONE[overall];

// The spine. Declared once because the whole point is that every row shares
// it — two copies would drift apart, which is the defect this replaced.
// 4.5rem clears "OTHERWISE", the widest label the panel can produce.
const ROW = "flex items-baseline gap-4";
const LABEL = "w-[4.5rem] shrink-0 font-mono text-[0.7rem] uppercase tracking-[0.14em]";
---

<aside
  aria-label="Exposure assessment"
  data-print-hide
  class:list={["mb-14 border-l-2 pl-5", tone.border]}
>
  <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-foreground">
    If published <span class="text-muted-foreground/40">&middot;</span>
    <span class:list={[tone.text]}>{overall === "none" ? "no risk" : `${overall} risk`}</span>
  </p>

  {/* The answer, first. Condition quiet, consequence loud, stacked so the
      break between them is a line break rather than a mid-sentence dash. */}
  {
    conditional ? (
      <dl class="mt-4 space-y-4">
        {verdict.rules.map(r => (
          <div class={ROW}>
            <dt class:list={[LABEL, "text-muted-foreground"]}>If</dt>
            <dd class="min-w-0">
              <span class="block text-[0.95rem] leading-snug text-muted-foreground">{r.if}</span>
              <span class="mt-0.5 block text-[1.05rem] font-medium leading-snug text-foreground">
                {r.then}
              </span>
            </dd>
          </div>
        ))}
        <div class={ROW}>
          <dt class:list={[LABEL, "text-muted-foreground"]}>Otherwise</dt>
          <dd class="min-w-0 text-[1.05rem] font-medium leading-snug text-foreground">
            {verdict.otherwise}
          </dd>
        </div>
      </dl>
    ) : (
      <div class:list={["mt-4", ROW]}>
        <span class={LABEL} aria-hidden="true" />
        <p class="min-w-0 text-[1.2rem] font-semibold leading-snug tracking-tight text-foreground">
          {sentence(verdict.otherwise)}.
        </p>
      </div>
    )
  }

  {/* The reasoning, second and quieter. Severity takes the label column, so
      it is a column you can read down rather than a word trailing off the end
      of a title of unpredictable length. */}
  <div class="mt-5 border-t border-border pt-5">
    {threats.length === 0 ? (
      <div class={ROW}>
        <span class={LABEL} aria-hidden="true" />
        <p class="min-w-0 text-[0.95rem] text-safe">No threats identified.</p>
      </div>
    ) : (
      <ol class="space-y-4">
        {threats.map(t => (
          <li class={ROW}>
            <span class:list={[LABEL, TONE[t.severity].text]}>{t.severity}</span>
            <div class="min-w-0">
              <p class="text-[0.95rem] leading-snug">
                <span class="font-medium text-foreground">{t.threat}</span>
                <span class="ml-2 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-foreground/60">
                  {t.category}
                </span>
              </p>
              <p class="mt-1 text-[0.875rem] leading-relaxed text-muted-foreground">
                {t.detail}
              </p>
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</aside>
