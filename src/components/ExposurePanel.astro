---
/**
 * Exposure assessment for a private article.
 *
 * INVARIANTS. Check a change against every one of these, in the rendered
 * output, before shipping it. They are the whole design: the panel is read by
 * moving your eyes to a place and expecting a part to be there, so a part that
 * moves between articles — or between two rows of the same card — costs more
 * than anything it could gain.
 *
 *   I1. A badge is the FIRST thing in its row, at the left edge of the
 *       content column. Header and threat rows are identical in this.
 *   I2. A metadata label always FOLLOWS its badge. Never precedes it.
 *   I3. The verdict is its own zone, closed by a rule.
 *   I4. Every threat renders badge row, title, detail — same order, same
 *       spacing, same type, always.
 *   I5. Three type sizes only. 0.7rem mono for labels and badges, 0.9375rem
 *       for prose, 1.25rem for the verdict. Emphasis is weight and colour.
 *   I6. One measure. Every block of prose wraps at the same width, so the
 *       right edge is as constant as the left one.
 *
 * I1 and I2 are written down because they were violated: the header rendered
 * label-then-badge while every threat rendered badge-then-label, so the same
 * two parts appeared in opposite order in one card.
 *
 * CLOSED BY DEFAULT. Most articles are never published, so the assessment is
 * only wanted when publishing is actually being weighed. Collapsed it is the
 * badge row and the verdict; the rest is one click away and nothing is cut. It
 * never opens itself, not even at high risk — a panel that opens under some
 * conditions is the variability these invariants exist to remove.
 *
 * FIXED ANATOMY. Same slots, same order, every article:
 *
 *   1. Risk badge and qualifier.   Always present.  } always visible
 *   2. The verdict, one line.      Always present.  }
 *   3. Exceptions to it.           Zero or more.    } behind the click
 *   4. The threats behind it.      One or more.     }
 *
 * The verdict is `verdict.otherwise` in all cases: it is the default outcome
 * and the rules are the cases that depart from it, which is why it can lead.
 *
 * CONVENTIONAL PARTS. A coloured left rail for the callout, as GitHub and
 * Notion set them; a badge for severity, as shadcn and Linear set status;
 * small uppercase mono for metadata. An earlier version hung every label in a
 * fixed column to the left of its content — a print convention borrowed into a
 * place it does not belong.
 *
 * Colour is semantic and traffic-light: green means no action needed, amber
 * means think before acting, red means stop. Never decorative, and the word is
 * always printed inside the badge so the signal never depends on colour alone.
 */
interface Threat {
  category: string;
  threat: string;
  severity: "low" | "moderate" | "high";
  detail: string;
}
interface Verdict {
  rules: { if: string; then: string }[];
  otherwise: string;
}
interface Props {
  exposure: { threats: Threat[]; verdict: Verdict };
}

const { exposure } = Astro.props;
const { threats, verdict } = exposure;

const rank = { low: 1, moderate: 2, high: 3 } as const;
const worst = threats.reduce((m, t) => Math.max(m, rank[t.severity]), 0);
const overall = (["none", "low", "moderate", "high"] as const)[worst];

const sentence = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const TONE = {
  none: { rail: "border-safe/60", badge: "border-safe/30 bg-safe/10 text-safe" },
  low: { rail: "border-safe/60", badge: "border-safe/30 bg-safe/10 text-safe" },
  moderate: { rail: "border-caution/70", badge: "border-caution/30 bg-caution/10 text-caution" },
  high: {
    rail: "border-destructive/70",
    badge: "border-destructive/30 bg-destructive/10 text-destructive",
  },
} as const;
const tone = TONE[overall];

// One definition per repeated part, so two rows cannot drift into two designs.
const LABEL = "font-mono text-[0.7rem] uppercase tracking-[0.14em]";
const BADGE = `inline-flex items-center rounded-md border px-1.5 py-0.5 font-medium ${LABEL}`;
const META = "flex items-center gap-2.5";            // I1, I2: badge first, label after
const MEASURE = "max-w-[32rem]";                     // I6
const PROSE = `text-[0.9375rem] leading-snug ${MEASURE}`;
const RULE = "mt-5 border-t border-border pt-5";
---

<aside
  aria-label="Exposure assessment"
  data-print-hide
  class:list={["mb-10 border-l-2 pl-5", tone.rail]}
>
  <details>
    <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      {/* 1. Risk. Badge first (I1), qualifier after it (I2). */}
      <div class="flex items-center justify-between gap-4">
        <span class={META}>
          <span class:list={[BADGE, tone.badge]}>
            {overall === "none" ? "no risk" : `${overall} risk`}
          </span>
          <span class:list={[LABEL, "text-muted-foreground"]}>If published</span>
        </span>
        <svg
          viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          class="chevron size-3 shrink-0 text-muted-foreground/50"
        >
          <path d="m9 18 6-6-6-6" />
        </svg>
      </div>

      {/* 2. The verdict. Same slot, same size, every article. */}
      <p
        class:list={[
          "mt-3 text-[1.25rem] font-semibold leading-snug tracking-tight text-foreground",
          MEASURE,
        ]}
      >
        {sentence(verdict.otherwise)}.
      </p>
    </summary>

    {/* 3. The cases that depart from it. I3: the rule above this closes the
        verdict's zone. The condition reads as the sentence it already is, so
        "if" is a word rather than a label in a gutter. */}
    {
      verdict.rules.length > 0 && (
        <dl class={RULE}>
          <div class="space-y-3">
            {verdict.rules.map(r => (
              <div>
                <dt class:list={[PROSE, "text-muted-foreground"]}>If {r.if}</dt>
                <dd class:list={["mt-0.5 font-medium text-foreground", PROSE]}>
                  {sentence(r.then)}
                </dd>
              </div>
            ))}
          </div>
        </dl>
      )
    }

    {/* 4. The reasoning. I4: every card is this shape, always. */}
    <div class={RULE}>
      {threats.length === 0 ? (
        <p class:list={[PROSE, "text-safe"]}>No threats identified.</p>
      ) : (
        <ol class="space-y-5">
          {threats.map(t => (
            <li>
              <div class={META}>
                <span class:list={[BADGE, TONE[t.severity].badge]}>{t.severity}</span>
                <span class:list={[LABEL, "text-muted-foreground/60"]}>{t.category}</span>
              </div>
              <p class:list={["mt-2 font-medium text-foreground", PROSE]}>{t.threat}</p>
              <p class:list={["mt-1 leading-normal text-muted-foreground", PROSE]}>{t.detail}</p>
            </li>
          ))}
        </ol>
      )}
    </div>
  </details>
</aside>

<style>
  /* Scoped CSS rather than a group-open: utility, so the one indicator of
     whether the panel is open does not depend on class extraction finding a
     variant. A chevron frozen pointing right is worse than no chevron. */
  .chevron {
    transition: transform 150ms ease;
    transform-origin: center;
  }
  details[open] .chevron {
    transform: rotate(90deg);
  }
  summary:hover .chevron {
    color: var(--color-muted-foreground);
  }
</style>
