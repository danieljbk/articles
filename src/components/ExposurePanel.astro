---
/**
 * Exposure assessment for a private article.
 *
 * Sits above the article and reads as a document header, not a widget. Two
 * design rules govern it:
 *
 *   1. The verdict leads. An earlier version listed every threat first and put
 *      the conclusion last, so you had to read the evidence to learn the
 *      answer — the inverse of how this is actually used. The decision is the
 *      headline; threats are the reasoning behind it.
 *   2. Unconditional verdicts are stated, not templated. Rendering "ALWAYS →
 *      never publish" forced a plain judgement through a conditional shape.
 *
 * Monochrome except severity, which is the one place a glance has to land.
 */
interface Threat {
  category: string;
  threat: string;
  severity: "low" | "moderate" | "high";
  detail: string;
}
interface Verdict {
  rules: { if: string; then: string }[];
  otherwise: string;
}
interface Props {
  exposure: { threats: Threat[]; verdict: Verdict };
}

const { exposure } = Astro.props;
const { threats, verdict } = exposure;

const rank = { low: 1, moderate: 2, high: 3 } as const;
const worst = threats.reduce((m, t) => Math.max(m, rank[t.severity]), 0);
const overall = (["none", "low", "moderate", "high"] as const)[worst];
const elevated = worst >= 3;

const sentence = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const conditional = verdict.rules.length > 0;
---

<aside
  aria-label="Exposure assessment"
  data-print-hide
  class:list={[
    "mb-14 border-l-2 pl-5",
    elevated ? "border-destructive/70" : "border-border",
  ]}
>
  <div class="flex items-baseline gap-2.5">
    <p class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-foreground">
      If published
    </p>
    <span
      class:list={[
        "font-mono text-[0.7rem] uppercase tracking-[0.14em]",
        elevated ? "text-destructive" : "text-muted-foreground/70",
      ]}
    >
      &middot; {overall} risk
    </span>
  </div>

  {/* The answer, first. */}
  {
    conditional ? (
      <dl class="mt-3 space-y-1.5">
        {verdict.rules.map(r => (
          <div class="text-[1.05rem] leading-snug">
            <dt class="inline font-mono text-[0.7rem] uppercase tracking-wider text-muted-foreground">
              If&nbsp;
            </dt>
            <dd class="inline text-muted-foreground">
              {r.if} — <span class="font-medium text-foreground">{r.then}</span>
            </dd>
          </div>
        ))}
        <div class="text-[1.05rem] leading-snug">
          <dt class="inline font-mono text-[0.7rem] uppercase tracking-wider text-muted-foreground">
            Otherwise&nbsp;
          </dt>
          <dd class="inline font-medium text-foreground">{verdict.otherwise}</dd>
        </div>
      </dl>
    ) : (
      <p class="mt-2 text-[1.35rem] font-semibold leading-tight tracking-tight text-foreground">
        {sentence(verdict.otherwise)}.
      </p>
    )
  }

  {/* The reasoning, second and quieter. */}
  {
    threats.length === 0 ? (
      <p class="mt-4 text-sm text-muted-foreground">No threats identified.</p>
    ) : (
      <ol class="mt-5 space-y-3.5">
        {threats.map(t => (
          <li>
            <p class="text-[0.9rem] leading-snug">
              <span class="font-mono text-[0.7rem] uppercase tracking-wider text-muted-foreground">
                {t.category}
              </span>
              <span class="mx-1.5 text-muted-foreground/40">/</span>
              <span class="font-medium text-foreground">{t.threat}</span>
              <span
                class:list={[
                  "ml-1.5 font-mono text-[0.7rem] uppercase tracking-wider",
                  t.severity === "high" ? "text-destructive" : "text-muted-foreground/70",
                ]}
              >
                {t.severity}
              </span>
            </p>
            <p class="mt-0.5 text-[0.875rem] leading-relaxed text-muted-foreground">
              {t.detail}
            </p>
          </li>
        ))}
      </ol>
    )
  }
</aside>
