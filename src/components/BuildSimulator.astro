---
/**
 * BuildSimulator — compares Ashe build paths by single-target DPS across core
 * count (1st core → 6th core), so you can read which itemization leads early,
 * mid, and late, and which is highest at each stage.
 *
 * Metric & constraints (fixed, documented in the page): level-18 Ashe, one
 * target at 80 armor / 40 MR, sustained basic attacks only. Conditional,
 * ramping, and multi-target damage (Runaan's bolts, energized procs, executes,
 * Yun Tal's ramp) is NOT counted as continuous DPS — those items contribute
 * their raw stats only, so on-hit/multi-target builds read LOWER here than they
 * play in a real teamfight. The model is the article's, extended with flat
 * always-on on-hit.
 *
 * Curves are computed server-side; the client script only toggles which build
 * is emphasized. Monochrome; the emphasized line is --foreground, the rest
 * recede to --muted-foreground.
 */

const BASE_AD = 118.5, BASE_X = 51, ARMOR = 80, MR = 40;

type Item = { n: string; ad?: number; as?: number; crit?: number; cd?: number; penPct?: number; leth?: number; ohM?: number; ohP?: number };
const I: Record<string, Item> = {
  boots: { n: "Berserker's Greaves", as: 35 },
  ie: { n: "Infinity Edge", ad: 75, crit: 25, cd: 30 },
  runaan: { n: "Runaan's Hurricane", as: 40, crit: 25 },
  pd: { n: "Phantom Dancer", as: 65, crit: 25 },
  ldr: { n: "Lord Dominik's Regards", ad: 35, crit: 25, penPct: 35 },
  collector: { n: "The Collector", ad: 50, crit: 25, leth: 10 },
  er: { n: "Essence Reaver", ad: 50, crit: 25 },
  yuntal: { n: "Yun Tal Wildarrows", ad: 50, as: 40, crit: 25 },
  wits: { n: "Wit's End", as: 50, ohM: 45 },
  kraken: { n: "Kraken Slayer", ad: 45, as: 40, ohP: 48 },
  guinsoo: { n: "Guinsoo's Rageblade", ad: 30, as: 25, ohM: 30 },
  botrk: { n: "Blade of the Ruined King", ad: 40, as: 25, ohP: 108 },
};

function mitig(r: number) { return 100 / (100 + Math.max(0, r)); }
function dpsAt(ids: string[]) {
  let ad = BASE_AD, x = BASE_X, c = 0, cd = 200, penPct = 0, leth = 0, ohM = 0, ohP = 0;
  for (const k of ids) {
    const it = I[k];
    ad += it.ad || 0; x += it.as || 0; c += it.crit || 0; cd += it.cd || 0;
    penPct = Math.max(penPct, it.penPct || 0); leth += it.leth || 0; ohM += it.ohM || 0; ohP += it.ohP || 0;
  }
  c = Math.min(100, c);
  const armorEff = Math.max(0, ARMOR * (1 - penPct / 100) - leth);
  const P = mitig(armorEff), M = mitig(MR);
  const R = Math.min(5, 0.658 * (1 + x / 100));
  const F = 1 + (c / 100) * (cd / 100 - 1);
  return R * (ad * F * P + ohP * P + ohM * M);
}

const builds = [
  { key: "crit", name: "Crit standard", path: ["boots", "ie", "pd", "runaan", "ldr", "collector"] },
  { key: "leth", name: "Lethality rush", path: ["boots", "collector", "ie", "ldr", "er", "pd"] },
  { key: "onhit", name: "On-hit / AS", path: ["boots", "wits", "kraken", "guinsoo", "botrk", "runaan"] },
  { key: "bal", name: "Balanced", path: ["boots", "ie", "runaan", "botrk", "ldr", "yuntal"] },
];
const STAGES = [1, 2, 3, 4, 5, 6];
const curves = builds.map((b) => ({
  ...b,
  dps: STAGES.map((s) => dpsAt(b.path.slice(0, s))),
}));
const leaderByStage = STAGES.map((_, si) => {
  let best = 0, bi = 0;
  curves.forEach((c, i) => { if (c.dps[si] > best) { best = c.dps[si]; bi = i; } });
  return curves[bi].key;
});

// chart geometry
const W = 720, H = 380, mL = 56, mR = 128, mT = 24, mB = 44;
const plotW = W - mL - mR, plotH = H - mT - mB;
const yMax = 1100;
const sx = (stage: number) => mL + ((stage - 1) / (STAGES.length - 1)) * plotW;
const sy = (v: number) => mT + (1 - v / yMax) * plotH;
const yTicks = [0, 250, 500, 750, 1000];
// end-label de-collision at the right edge
const ends = curves
  .map((c) => ({ key: c.key, name: c.name, y: sy(c.dps[c.dps.length - 1]), dps: c.dps[c.dps.length - 1] }))
  .sort((a, b) => a.y - b.y);
for (let i = 1; i < ends.length; i++) {
  if (ends[i].y - ends[i - 1].y < 16) ends[i].y = ends[i - 1].y + 16;
}
const labelY: Record<string, number> = {};
ends.forEach((e) => { labelY[e.key] = e.y; });
---

<div class="sim" id="sim">
  <div class="sim-chart">
    <svg viewBox={`0 0 ${W} ${H}`} class="sim-svg" role="img" aria-label="Single-target DPS of four Ashe build paths across core count, one to six items.">
      {yTicks.map((t) => (
        <g>
          <line class="sim-grid" x1={mL} y1={sy(t)} x2={W - mR} y2={sy(t)} />
          <text class="sim-tick" x={mL - 9} y={sy(t) + 4} text-anchor="end">{t.toLocaleString()}</text>
        </g>
      ))}
      <line class="sim-axis" x1={mL} y1={sy(0)} x2={W - mR} y2={sy(0)} />
      {STAGES.map((s) => (
        <text class="sim-tick" x={sx(s)} y={H - mB + 20} text-anchor="middle">{s}</text>
      ))}
      <text class="sim-axistitle" x={mL + plotW / 2} y={H - 6} text-anchor="middle">cores completed</text>
      <text class="sim-axistitle" x={mL - 9} y={mT - 10} text-anchor="start">single-target DPS</text>

      {curves.map((c) => (
        <g class="sim-series" data-key={c.key}>
          <polyline
            class="sim-line"
            points={c.dps.map((v, i) => `${sx(STAGES[i])},${sy(v)}`).join(" ")}
          />
          {c.dps.map((v, i) => (<circle class="sim-dot" cx={sx(STAGES[i])} cy={sy(v)} r="3" />))}
          <text class="sim-endlabel" x={W - mR + 8} y={labelY[c.key] + 4}>{c.name}</text>
        </g>
      ))}
    </svg>
  </div>

  <div class="sim-tablewrap">
    <table class="sim-table">
      <thead>
        <tr><th>Build</th>{STAGES.map((s) => (<th class="num">{s} core{s > 1 ? "s" : ""}</th>))}</tr>
      </thead>
      <tbody>
        {curves.map((c) => (
          <tr class="sim-row" data-key={c.key}>
            <th class="sim-name" scope="row"><span class="sim-key"></span>{c.name}</th>
            {c.dps.map((v, i) => (
              <td class={"num" + (leaderByStage[i] === c.key ? " lead" : "")}>{Math.round(v).toLocaleString()}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <div class="sim-hint">Bold = the highest-DPS build at that core count. Hover a row to trace its curve.</div>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.getElementById("sim");
    if (!root) return;
    function emphasize(key) {
      root.querySelectorAll(".sim-series").forEach(function (g) {
        g.classList.toggle("dim", key != null && g.getAttribute("data-key") !== key);
        g.classList.toggle("hot", key != null && g.getAttribute("data-key") === key);
      });
      root.querySelectorAll(".sim-row").forEach(function (r) {
        r.classList.toggle("hot", key != null && r.getAttribute("data-key") === key);
      });
    }
    root.querySelectorAll(".sim-row").forEach(function (r) {
      var key = r.getAttribute("data-key");
      r.addEventListener("mouseenter", function () { emphasize(key); });
      r.addEventListener("mouseleave", function () { emphasize(null); });
    });
    root.querySelectorAll(".sim-series").forEach(function (g) {
      var key = g.getAttribute("data-key");
      g.addEventListener("mouseenter", function () { emphasize(key); });
      g.addEventListener("mouseleave", function () { emphasize(null); });
    });
  })();
</script>

<style>
  .sim {
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius);
    background: hsl(var(--card));
    margin: 2rem 0;
    overflow: hidden;
  }
  .sim-chart { padding: 1.1rem 1.1rem 0.4rem; }
  .sim-svg { width: 100%; height: auto; display: block; font-family: var(--font-mono); overflow: visible; }
  .sim-grid { stroke: hsl(var(--border)); stroke-width: 1; }
  .sim-axis { stroke: hsl(var(--muted-foreground)); stroke-width: 1; opacity: 0.55; }
  .sim-tick { fill: hsl(var(--muted-foreground)); font-size: 12px; }
  .sim-axistitle { fill: hsl(var(--muted-foreground)); font-size: 12px; font-family: var(--font-sans); }
  .sim-line { fill: none; stroke: hsl(var(--muted-foreground)); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; opacity: 0.9; }
  .sim-dot { fill: hsl(var(--muted-foreground)); stroke: hsl(var(--card)); stroke-width: 1.5; }
  .sim-endlabel { fill: hsl(var(--muted-foreground)); font-size: 11.5px; font-family: var(--font-sans); }
  /* emphasis */
  .sim-series.hot .sim-line { stroke: hsl(var(--foreground)); stroke-width: 2.5; opacity: 1; }
  .sim-series.hot .sim-dot { fill: hsl(var(--foreground)); }
  .sim-series.hot .sim-endlabel { fill: hsl(var(--foreground)); font-weight: 600; }
  .sim-series.dim .sim-line { opacity: 0.25; }
  .sim-series.dim .sim-dot { opacity: 0.2; }
  .sim-series.dim .sim-endlabel { opacity: 0.35; }

  .sim-tablewrap { border-top: 1px solid hsl(var(--border)); padding: 1rem 1.1rem 1.1rem; overflow-x: auto; }
  .sim-table { border-collapse: collapse; width: 100%; font-size: 0.86rem; }
  .sim-table th, .sim-table td { padding: 0.45rem 0.6rem; border-bottom: 1px solid hsl(var(--border)); text-align: left; }
  .sim-table thead th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: hsl(var(--muted-foreground)); font-weight: 500; white-space: nowrap; }
  .sim-table .num { text-align: right; font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: hsl(var(--muted-foreground)); }
  .sim-table td.lead { color: hsl(var(--foreground)); font-weight: 600; }
  .sim-name { font-weight: 500; color: hsl(var(--foreground)); white-space: nowrap; }
  .sim-key { display: inline-block; width: 0.7rem; height: 0.15rem; background: hsl(var(--muted-foreground)); border-radius: 2px; margin-right: 0.45rem; vertical-align: middle; }
  .sim-row { cursor: default; }
  .sim-row.hot td, .sim-row.hot th { background: hsl(var(--secondary)); }
  .sim-row.hot .sim-key { background: hsl(var(--foreground)); }
  .sim-row:last-child td, .sim-row:last-child th { border-bottom: 0; }
  .sim-hint { margin-top: 0.7rem; font-size: 0.8rem; color: hsl(var(--muted-foreground)); line-height: 1.4; }
</style>
