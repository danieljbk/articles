---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
];

// The archive lives at /private, which is where almost everything is. Gated on
// the same flag as the private routes themselves, so it cannot reach
// production — Cloudflare never sets INCLUDE_PRIVATE, so the link is absent
// there exactly as the pages are. Styled as a badge rather than a nav item to
// mark it as the local-only affordance.
const includePrivate = process.env.INCLUDE_PRIVATE === "1";
---

<header class="border-b border-border">
  <div
    class="mx-auto flex max-w-2xl items-center justify-between px-6 py-4"
  >
    <a
      href="/"
      class="font-semibold tracking-tight hover:text-foreground/80"
    >
      articles
    </a>
    <nav class="flex items-center gap-5 text-sm text-muted-foreground">
      {
        links.map(link => (
          <a
            href={link.href}
            class:list={[
              "hover:text-foreground",
              isActive(link.href) && "text-foreground",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      {
        includePrivate && (
          <a
            href="/private"
            class:list={[
              "rounded-md border border-border bg-secondary px-2 py-0.5 font-mono text-xs uppercase tracking-wide hover:text-foreground",
              isActive("/private") ? "text-foreground" : "text-muted-foreground",
            ]}
          >
            private
          </a>
        )
      }
    </nav>
  </div>
</header>
