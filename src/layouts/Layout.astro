---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "articles.kwon.ai",
  description = "Articles by Daniel Kwon.",
} = Astro.props;

const fullTitle =
  title === "articles.kwon.ai" ? title : `${title} · articles.kwon.ai`;

const noindex = Astro.url.pathname.startsWith("/private");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="articles.kwon.ai"
      href="/rss.xml"
    />

    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <slot />
    <Footer />

    <script>
      // Decorate every <pre> inside article prose with a copy button.
      // Uses astro:page-load so it re-runs after every client-side navigation
      // when ClientRouter is active (and on first load when it isn't).
      function decorateCodeBlocks() {
        document
          .querySelectorAll(".article-prose pre:not([data-copy-attached])")
          .forEach(pre => {
            const code = pre.querySelector("code");
            if (!code) return;
            // Cache textContent BEFORE appending the button — otherwise the
            // button's own text would end up on the clipboard.
            const text = code.textContent ?? "";
            const button = document.createElement("button");
            button.type = "button";
            button.className = "copy-button";
            button.setAttribute("aria-label", "Copy code to clipboard");
            button.textContent = "Copy";
            button.addEventListener("click", () => {
              navigator.clipboard.writeText(text).then(() => {
                button.textContent = "Copied";
                button.dataset.copied = "true";
                setTimeout(() => {
                  button.textContent = "Copy";
                  delete button.dataset.copied;
                }, 1500);
              });
            });
            pre.appendChild(button);
            pre.setAttribute("data-copy-attached", "true");
          });
      }

      document.addEventListener("astro:page-load", decorateCodeBlocks);
    </script>
  </body>
</html>
